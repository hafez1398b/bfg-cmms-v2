NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://cmms_user:change-me@database:5432/bfg_cmms
JWT_SECRET=replace-with-at-least-64-random-characters
ALLOW_LOCAL_COMPATIBILITY=false

# Local OpenAI-compatible inference (preferred, on-premise)
LOCAL_AI_BASE_URL=http://ai-server:11434/v1
LOCAL_AI_MODEL=deepseek-r1-distill-qwen-32b
LOCAL_AI_API_KEY=
LOCAL_AI_VISION=false

# DeepSeek cloud reasoning (enable DB policy only after data-processing approval)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION=false

# Google Gemini multimodal/search (supported deployment region required)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SEARCH_ENABLED=false

AI_TIMEOUT_MS=45000
OUTBOX_INTERVAL_MS=1000
