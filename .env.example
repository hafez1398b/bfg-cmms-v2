NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://user:example-only@database:5432/bfg_cmms
ADMIN_INITIAL_PASSWORD=example-only-use-a-random-12-character-password
ADMIN_INITIAL_PASSWORD=example-only-use-a-random-12-character-password
# Access cookies expire after 15 minutes; login sessions have a 45-minute absolute maximum.
# JWT_SECRET signs access cookies and hashes refresh tokens. Never put it in an installer.
JWT_SECRET=example-only-replace-with-a-random-secret
EXECUTION_MODE=server-only
ALLOW_LOCAL_COMPATIBILITY=false
# Local backup file required by npm run update:apply. Never a URL.
# BACKUP_PATH=

# Local OpenAI-compatible inference (preferred, on-premise)
LOCAL_AI_BASE_URL=http://ai-server:11434/v1
LOCAL_AI_MODEL=deepseek-r1-distill-qwen-32b
LOCAL_AI_API_KEY=
LOCAL_AI_VISION=false

# DeepSeek cloud reasoning (enable DB policy only after data-processing approval)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION=false

# Google Gemini multimodal/search (supported deployment region required)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SEARCH_ENABLED=false

AI_TIMEOUT_MS=45000
OUTBOX_INTERVAL_MS=1000
