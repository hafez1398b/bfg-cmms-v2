+    if(domain==='inventory'){result=inventory();title='سلامت هوشمند انبار';metrics=[['کل اقلام',fmt(result.total)],['زیر نقطه سفارش',fmt(result.low)],['نزدیک حداقل',fmt(result.near)]];}
