++CREATE TABLE IF NOT EXISTS asset_spare_parts (
++  asset_id TEXT NOT NULL REFERENCES assets(id) ON DELETE CASCADE,
++  item_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
