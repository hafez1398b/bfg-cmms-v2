+    modal(mhead('ویرایش درخواست '+text(record.no))+`<div class="m-body"><div class="frow"><div class="field"><label>تجهیز</label><select id="raAsset"><option value="">— بدون تجهیز —</option>${activeAssetOptions(record.assetId)}</select></div><div class="field"><label>اولویت</label><select id="raUrg">${Object.entries(PR).map(([key,value])=>`<option value="${key}" ${record.urgency===key?'selected':''}>${value[0]}</option>`).join('')}</select></div></div><div class="field"><label>شرح درخواست *</label><textarea id="raDesc" rows="4">${text(record.desc||record.descr||'')}</textarea></div></div><div class="m-foot"><button class="btn btn-primary" onclick="saveRequestRecord('${id}')">ذخیره</button><button class="btn btn-ghost" onclick="openReq('${id}')">انصراف</button></div>`);
