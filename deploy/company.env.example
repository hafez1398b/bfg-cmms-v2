# Copy to .env. Never commit the resulting .env file.
POSTGRES_DB=bfg_cmms
POSTGRES_USER=bfg_cmms
POSTGRES_PASSWORD=GENERATED_BY_INSTALLER
JWT_SECRET=GENERATED_BY_INSTALLER
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATED_BY_INSTALLER

APP_BIND_IP=0.0.0.0
APP_PORT=8080
# Optional comma-separated cross-origin clients. Leave empty for normal same-origin use.
APP_ORIGINS=
AUTO_SEED_BESPAR1=true

# Internal model (optional). For the bundled Ollama profile use http://local-ai:11434/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
LOCAL_AI_VISION=false

# Cloud providers (optional; secrets remain server-side)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION=false

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SEARCH_ENABLED=false
AI_TIMEOUT_MS=45000
